import React, { useState, useEffect, useRef } from 'react';
import { 
  Users, Upload, Printer, Monitor, Radio, 
  Trash2, UserPlus, PlaySquare, Settings, AlertCircle, X,
  Download, Cloud, CloudOff, RefreshCw
} from 'lucide-react';

export default function App() {
  const [activeTab, setActiveTab] = useState('dashboard');
  
  // App State (In-Memory)
  const [students, setStudents] = useState([
    // Initial mock data for demonstration
    { id: '1', name: 'Emma Johnson', grade: '1st', teacher: 'Ms. Smith', carNumber: '101' },
    { id: '2', name: 'Liam Williams', grade: '2nd', teacher: 'Mr. Davis', carNumber: '102' },
    { id: '3', name: 'Olivia Brown', grade: 'Kindergarten', teacher: 'Mrs. Wilson', carNumber: '103' },
  ]);
  
  const [callQueue, setCallQueue] = useState([]); // [{ queueId, studentId, timestamp }]
  
  // --- Google Workspace Sync (Apps Script) ---
  const [gasUrl, setGasUrl] = useState('');
  const [syncStatus, setSyncStatus] = useState('offline'); // offline, syncing, online, error

  const pushToCloud = async (bodyData) => {
    if (!gasUrl) return;
    setSyncStatus('syncing');
    try {
      await fetch(gasUrl, {
        method: 'POST',
        mode: 'no-cors', // Avoids CORS preflight block for simple cross-origin POSTs
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyData)
      });
      // no-cors mode has an opaque response, so we assume success if no fetch throw
      setSyncStatus('online');
    } catch (err) {
      console.error('Push error:', err);
      setSyncStatus('error');
    }
  };

  const fetchFromCloud = async () => {
    if (!gasUrl) return;
    setSyncStatus('syncing');
    try {
      const res = await fetch(`${gasUrl}?action=getData`);
      const data = await res.json();
      if (data.students) setStudents(data.students);
      if (data.queue) setCallQueue(data.queue);
      setSyncStatus('online');
    } catch (err) {
      console.error('Fetch error:', err);
      setSyncStatus('error');
    }
  };

  // Poll Google Apps Script for live updates across devices
  useEffect(() => {
    if (!gasUrl) {
      setSyncStatus('offline');
      return;
    }
    fetchFromCloud(); // Initial pull
    const interval = setInterval(fetchFromCloud, 3000); // Poll every 3 seconds
    return () => clearInterval(interval);
  }, [gasUrl]);

  const handleSetStudents = (newStudents) => {
    setStudents(newStudents);
    pushToCloud({ action: 'updateStudents', payload: newStudents });
  };

  const handleSetQueue = (newQueue) => {
    setCallQueue(newQueue);
    pushToCloud({ action: 'updateQueue', payload: newQueue });
  };

  // --- Admin Functions ---
  const handleExportCSV = () => {
    if (students.length === 0) return alert('No students to export.');
    const headers = ['Car Number', 'Student Name', 'Grade', 'Teacher'];
    const csvContent = [
      headers.join(','),
      ...students.map(s => `"${s.carNumber}","${s.name}","${s.grade}","${s.teacher}"`)
    ].join('\n');

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', 'school_rider_roster.csv');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const handleFileUpload = (e) => {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (evt) => {
      const text = evt.target.result;
      const lines = text.split('\n');
      
      let newStudents = [...students];
      let maxNumber = students.reduce((max, s) => Math.max(max, parseInt(s.carNumber) || 0), 100);

      // Skip header row if it exists (assuming Name, Grade, Teacher)
      const startIdx = lines[0].toLowerCase().includes('name') ? 1 : 0;

      for (let i = startIdx; i < lines.length; i++) {
        if (!lines[i].trim()) continue;
        const cols = lines[i].split(',').map(c => c.trim().replace(/^"|"$/g, ''));
        
        if (cols.length >= 3) {
          maxNumber++;
          newStudents.push({
            id: Math.random().toString(36).substr(2, 9),
            name: cols[0],
            grade: cols[1],
            teacher: cols[2],
            carNumber: maxNumber.toString()
          });
        }
      }
      handleSetStudents(newStudents);
      alert('Spreadsheet loaded and numbers assigned successfully!');
    };
    reader.readAsText(file);
    e.target.value = null; // reset input
  };

  const removeStudent = (id) => {
    handleSetStudents(students.filter(s => s.id !== id));
  };

  const clearQueue = () => {
    if(window.confirm('Are you sure you want to clear the active dismissal board?')) {
      handleSetQueue([]);
    }
  };

  // --- Dispatcher Functions ---
  const [dispatcherInput, setDispatcherInput] = useState('');
  const [dispatcherMessage, setDispatcherMessage] = useState({ text: '', type: '' });

  const handleCallStudent = (e) => {
    e.preventDefault();
    if (!dispatcherInput.trim()) return;

    const student = students.find(s => s.carNumber === dispatcherInput.trim());
    
    if (student) {
      const newQueue = [
        { queueId: Math.random().toString(36).substr(2, 9), student, timestamp: Date.now() },
        ...callQueue
      ];
      handleSetQueue(newQueue);
      setDispatcherMessage({ text: `${student.name} (Grade ${student.grade}) called.`, type: 'success' });
    } else {
      setDispatcherMessage({ text: `Car Number ${dispatcherInput} not found.`, type: 'error' });
    }
    
    setDispatcherInput('');
    
    // Clear message after 3 seconds
    setTimeout(() => setDispatcherMessage({ text: '', type: '' }), 3000);
  };

  const removeFromQueue = (queueId) => {
    handleSetQueue(callQueue.filter(q => q.queueId !== queueId));
  };

  // --- Views ---

  const renderAdmin = () => (
    <div className="p-6 max-w-6xl mx-auto animate-in fade-in">
      <div className="flex justify-between items-center mb-8">
        <div>
          <h2 className="text-3xl font-bold text-gray-800">Admin Dashboard</h2>
          <p className="text-gray-500">Manage student roster and print car rider cards.</p>
        </div>
        <div className="flex gap-4">
          <button 
            onClick={handleExportCSV}
            className="flex items-center gap-2 bg-green-600 text-white px-4 py-2 rounded-lg shadow hover:bg-green-700 transition"
          >
            <Download size={20} />
            Export CSV
          </button>
          <button 
            onClick={() => setActiveTab('print')}
            className="flex items-center gap-2 bg-purple-600 text-white px-4 py-2 rounded-lg shadow hover:bg-purple-700 transition"
          >
            <Printer size={20} />
            Print Cards
          </button>
        </div>
      </div>

      <div className="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
        <div className="flex justify-between items-center mb-4">
          <h3 className="text-xl font-semibold flex items-center gap-2">
            <Cloud className="text-blue-500" /> Google Workspace Sync
          </h3>
          <div className="flex items-center gap-2">
            {syncStatus === 'online' && <span className="flex items-center gap-1 text-sm text-green-600 font-medium"><Cloud size={16}/> Connected</span>}
            {syncStatus === 'syncing' && <span className="flex items-center gap-1 text-sm text-blue-600 font-medium"><RefreshCw size={16} className="animate-spin"/> Syncing...</span>}
            {syncStatus === 'error' && <span className="flex items-center gap-1 text-sm text-red-600 font-medium"><CloudOff size={16}/> Sync Error</span>}
            {syncStatus === 'offline' && <span className="flex items-center gap-1 text-sm text-gray-400 font-medium"><CloudOff size={16}/> Offline</span>}
          </div>
        </div>
        <p className="text-sm text-gray-600 mb-4">
          To sync in real-time across your school, paste your Google Apps Script Web App URL below. All devices must use this same URL.
        </p>
        <div className="flex gap-4">
          <input 
            type="url" 
            placeholder="https://script.google.com/macros/s/.../exec"
            value={gasUrl}
            onChange={(e) => setGasUrl(e.target.value)}
            className="flex-grow px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
          />
          <button onClick={fetchFromCloud} className="bg-blue-100 text-blue-700 px-4 py-2 rounded-lg hover:bg-blue-200 transition font-medium flex items-center gap-2 whitespace-nowrap">
            <RefreshCw size={18} /> Force Sync
          </button>
        </div>
      </div>

      <div className="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
        <h3 className="text-xl font-semibold mb-4 flex items-center gap-2">
          <Upload className="text-blue-500" /> Upload Roster (CSV)
        </h3>
        <p className="text-sm text-gray-600 mb-4">
          Upload a CSV file with columns: <strong>Name, Grade, Teacher</strong>. The system will automatically assign unique car rider numbers to new students.
        </p>
        <label className="flex items-center justify-center w-full h-32 px-4 transition bg-white border-2 border-gray-300 border-dashed rounded-md appearance-none cursor-pointer hover:border-blue-400 focus:outline-none">
            <span className="flex items-center space-x-2">
                <Upload className="w-6 h-6 text-gray-600" />
                <span className="font-medium text-gray-600">Drop files to Attach, or browse</span>
            </span>
            <input type="file" name="file_upload" className="hidden" accept=".csv" onChange={handleFileUpload} />
        </label>
      </div>

      <div className="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div className="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
          <h3 className="text-xl font-semibold flex items-center gap-2">
            <Users className="text-blue-500" /> Current Roster ({students.length})
          </h3>
        </div>
        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse">
            <thead>
              <tr className="bg-gray-50 text-gray-600 text-sm uppercase tracking-wider">
                <th className="p-4 font-semibold border-b">Car #</th>
                <th className="p-4 font-semibold border-b">Student Name</th>
                <th className="p-4 font-semibold border-b">Grade</th>
                <th className="p-4 font-semibold border-b">Teacher</th>
                <th className="p-4 font-semibold border-b text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              {students.length === 0 ? (
                <tr>
                  <td colSpan="5" className="p-8 text-center text-gray-500">No students loaded. Upload a roster to begin.</td>
                </tr>
              ) : (
                students.map(s => (
                  <tr key={s.id} className="border-b hover:bg-gray-50 transition">
                    <td className="p-4 font-bold text-blue-600">{s.carNumber}</td>
                    <td className="p-4 font-medium text-gray-800">{s.name}</td>
                    <td className="p-4 text-gray-600">{s.grade}</td>
                    <td className="p-4 text-gray-600">{s.teacher}</td>
                    <td className="p-4 text-right">
                      <button onClick={() => removeStudent(s.id)} className="text-red-500 hover:text-red-700 p-2 rounded-full hover:bg-red-50">
                        <Trash2 size={18} />
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );

  const renderPrintView = () => (
    <div className="bg-white min-h-screen">
      <div className="no-print p-4 bg-gray-800 text-white flex justify-between items-center sticky top-0 z-10">
        <div className="flex items-center gap-4">
          <button onClick={() => setActiveTab('admin')} className="text-gray-300 hover:text-white flex items-center gap-1">
            <X size={20} /> Close Print View
          </button>
          <h2 className="text-xl font-semibold">Car Rider Cards ({students.length})</h2>
        </div>
        <button 
          onClick={() => window.print()}
          className="bg-blue-500 hover:bg-blue-600 px-6 py-2 rounded-lg font-medium flex items-center gap-2 shadow-lg"
        >
          <Printer size={20} /> Print Now
        </button>
      </div>

      <div className="print-container p-8 grid grid-cols-2 gap-8">
        {students.map(s => (
          <div key={s.id} className="border-4 border-black rounded-2xl p-8 flex flex-col items-center justify-center text-center h-80 relative" style={{ pageBreakInside: 'avoid' }}>
            <div className="absolute top-4 left-4 text-lg font-bold text-gray-500 uppercase tracking-widest">{s.grade}</div>
            <div className="absolute top-4 right-4 text-lg font-bold text-gray-500 uppercase">{s.teacher}</div>
            
            <h1 className="text-9xl font-black text-black mb-4 tracking-tighter" style={{ fontSize: '10rem', lineHeight: '1' }}>{s.carNumber}</h1>
            <h2 className="text-4xl font-bold text-gray-800">{s.name}</h2>
          </div>
        ))}
      </div>
    </div>
  );

  const renderDispatcher = () => (
    <div className="min-h-[80vh] flex flex-col items-center justify-center p-6 animate-in fade-in">
      <div className="max-w-md w-full bg-white rounded-3xl shadow-xl p-8 border border-gray-100">
        <div className="text-center mb-8">
          <div className="bg-blue-100 text-blue-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <Radio size={32} />
          </div>
          <h2 className="text-3xl font-bold text-gray-800">Dispatcher</h2>
          <p className="text-gray-500 mt-2">Enter car numbers to send to classrooms.</p>
        </div>

        <form onSubmit={handleCallStudent} className="space-y-6">
          <div>
            <input
              type="number"
              value={dispatcherInput}
              onChange={(e) => setDispatcherInput(e.target.value)}
              placeholder="Enter Car #"
              className="w-full text-center text-6xl font-black py-6 border-4 border-gray-200 rounded-2xl focus:border-blue-500 focus:outline-none transition-colors"
              autoFocus
            />
          </div>
          <button 
            type="submit"
            className="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-2xl py-6 rounded-2xl shadow-lg transition-transform active:scale-95 flex items-center justify-center gap-3"
          >
            <PlaySquare size={28} /> CALL STUDENT
          </button>
        </form>

        {dispatcherMessage.text && (
          <div className={`mt-6 p-4 rounded-xl text-center font-medium flex items-center justify-center gap-2 animate-in slide-in-from-bottom-4 ${dispatcherMessage.type === 'success' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
            {dispatcherMessage.type === 'error' && <AlertCircle size={20} />}
            {dispatcherMessage.text}
          </div>
        )}
      </div>
    </div>
  );

  const renderDashboard = () => {
    const currentCall = callQueue.length > 0 ? callQueue[0] : null;
    const history = callQueue.length > 1 ? callQueue.slice(1) : [];

    return (
      <div className="h-[calc(100vh-80px)] flex bg-gray-100 p-4 gap-4 animate-in fade-in">
        
        {/* Left Side: Current Call (Massive Display) */}
        <div className="flex-grow bg-white rounded-3xl shadow-lg border-2 border-blue-100 flex flex-col relative overflow-hidden">
          <div className="bg-blue-600 text-white p-6 flex justify-between items-center">
            <h1 className="text-4xl font-black uppercase tracking-wider flex items-center gap-3">
              <Monitor size={36} /> Classroom Dismissal Board
            </h1>
            <div className="text-blue-200 text-xl font-bold">
              {new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' })}
            </div>
          </div>
          
          <div className="flex-grow flex flex-col items-center justify-center p-12 text-center">
            {currentCall ? (
              <div key={currentCall.queueId} className="animate-in zoom-in duration-500">
                <div className="inline-block bg-blue-100 text-blue-800 text-4xl font-bold px-8 py-3 rounded-full mb-8">
                  NOW DISMISSING
                </div>
                <h2 className="text-[12rem] leading-none font-black text-gray-900 mb-4 drop-shadow-sm">
                  {currentCall.student.carNumber}
                </h2>
                <h3 className="text-7xl font-bold text-gray-800 mb-6">
                  {currentCall.student.name}
                </h3>
                <p className="text-5xl font-medium text-gray-500">
                  {currentCall.student.grade} • {currentCall.student.teacher}
                </p>
              </div>
            ) : (
              <div className="text-gray-300 flex flex-col items-center">
                <Monitor size={120} className="mb-8 opacity-50" />
                <h2 className="text-5xl font-bold">Waiting for dispatch...</h2>
              </div>
            )}
          </div>
        </div>

        {/* Right Side: Running List */}
        <div className="w-1/3 bg-white rounded-3xl shadow-lg border-2 border-gray-100 flex flex-col">
          <div className="bg-gray-800 text-white p-6 rounded-t-3xl flex justify-between items-center">
            <h2 className="text-2xl font-bold">Recently Called</h2>
            <button onClick={clearQueue} className="text-gray-400 hover:text-white text-sm flex items-center gap-1 transition">
              <Trash2 size={16} /> Clear Board
            </button>
          </div>
          
          <div className="flex-grow overflow-y-auto p-4 space-y-3">
            {history.length === 0 && callQueue.length <= 1 ? (
              <div className="text-center text-gray-400 mt-10 text-lg">No previous calls yet.</div>
            ) : (
              history.map((q, index) => (
                <div 
                  key={q.queueId} 
                  className={`flex items-center justify-between p-4 rounded-2xl border-2 transition-all ${
                    index === 0 ? 'bg-gray-50 border-gray-200' : 'border-transparent hover:bg-gray-50'
                  }`}
                >
                  <div className="flex items-center gap-4">
                    <div className="bg-gray-200 text-gray-700 font-black text-2xl w-14 h-14 rounded-xl flex items-center justify-center">
                      {q.student.carNumber}
                    </div>
                    <div>
                      <div className="font-bold text-xl text-gray-800">{q.student.name}</div>
                      <div className="text-gray-500 font-medium">{q.student.grade}</div>
                    </div>
                  </div>
                  <button onClick={() => removeFromQueue(q.queueId)} className="text-gray-300 hover:text-red-500 p-2">
                    <X size={24} />
                  </button>
                </div>
              ))
            )}
          </div>
        </div>

      </div>
    );
  };

  // --- Main Layout ---
  
  // Hide main layout if printing
  if (activeTab === 'print') {
    return renderPrintView();
  }

  return (
    <div className="min-h-screen bg-slate-50 font-sans text-gray-900">
      {/* CSS for print styling injected globally */}
      <style>{`
        @media print {
          body { background-color: white !important; }
          .no-print { display: none !important; }
          .print-container { padding: 0 !important; grid-template-columns: repeat(2, 1fr) !important; gap: 20px !important; }
        }
      `}</style>

      {/* Navigation Top Bar */}
      <nav className="bg-white border-b border-gray-200 sticky top-0 z-40 no-print shadow-sm">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between h-20">
            <div className="flex items-center gap-3">
              <div className="bg-blue-600 p-2 rounded-lg text-white">
                <PlaySquare size={24} />
              </div>
              <span className="font-black text-2xl tracking-tight text-gray-800">
                School<span className="text-blue-600">Rider</span>
              </span>
            </div>
            
            <div className="flex items-center space-x-2">
              <button
                onClick={() => setActiveTab('admin')}
                className={`px-5 py-3 rounded-xl font-medium transition-all flex items-center gap-2 ${
                  activeTab === 'admin' ? 'bg-blue-100 text-blue-700 shadow-sm' : 'text-gray-600 hover:bg-gray-100'
                }`}
              >
                <Settings size={20} /> Admin Setup
              </button>
              <button
                onClick={() => setActiveTab('dispatcher')}
                className={`px-5 py-3 rounded-xl font-medium transition-all flex items-center gap-2 ${
                  activeTab === 'dispatcher' ? 'bg-blue-100 text-blue-700 shadow-sm' : 'text-gray-600 hover:bg-gray-100'
                }`}
              >
                <Radio size={20} /> Dispatcher
              </button>
              <button
                onClick={() => setActiveTab('dashboard')}
                className={`px-5 py-3 rounded-xl font-medium transition-all flex items-center gap-2 ${
                  activeTab === 'dashboard' ? 'bg-blue-100 text-blue-700 shadow-sm' : 'text-gray-600 hover:bg-gray-100'
                }`}
              >
                <Monitor size={20} /> Classroom Board
              </button>
            </div>
          </div>
        </div>
      </nav>

      {/* Main Content Area */}
      <main className="no-print">
        {activeTab === 'admin' && renderAdmin()}
        {activeTab === 'dispatcher' && renderDispatcher()}
        {activeTab === 'dashboard' && renderDashboard()}
      </main>
    </div>
  );
}
